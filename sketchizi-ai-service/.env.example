# Local development only. Never commit actual values.
PORT=8090
DATABASE_URL=jdbc:postgresql://YOUR-NEON-HOST/YOUR_DB?sslmode=require
DATABASE_USERNAME=YOUR_DB_USER
DATABASE_PASSWORD=REPLACE_ME
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
AI_IDENTITY_HMAC_SECRET=SET_TO_THE_EXACT_SAME_RANDOM_SECRET_AS_CLOUDFLARE
AI_MAX_REQUEST_BODY_BYTES=921600
AI_MAX_DIAGRAM_ELEMENTS=1500
AI_MAX_DIAGRAM_CONTEXT_CHARS=180000
AI_MAX_REQUESTS_PER_MINUTE=60
AI_MAX_SUBMISSIONS_PER_MINUTE=10
AI_MAX_CONCURRENT_REQUESTS=2
AI_RESERVATION_LEASE_SECONDS=120
AI_CONVERSATION_QUESTION_LIMIT=5
AI_ACCOUNT_QUESTION_LIMIT=10
AI_ACCOUNT_WINDOW_HOURS=12
AI_PROVIDER_TIMEOUT_SECONDS=45
AI_MAX_ANSWER_CHARS=16000
DB_POOL_SIZE=5
