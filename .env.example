# Server-side Cloudflare Pages Function variables. These are NOT Vite client variables.
# Do not use VITE_ prefixes and never expose this file's real values in a frontend bundle.
AUTH_SERVICE_ORIGIN=https://YOUR-AUTH-SERVICE.onrender.com
AI_SERVICE_ORIGIN=https://YOUR-AI-SERVICE.onrender.com
AI_IDENTITY_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_SHARED_WITH_AI_SERVICE
PUBLIC_FRONTEND_ORIGIN=https://sketchizi.pages.dev
