# Server-side Cloudflare Pages Function variables. These are NOT Vite client variables.
# During the unified-backend rollout, both origins point to the same Render service.
# Do not use VITE_ prefixes and never expose secrets in a frontend bundle.
AUTH_SERVICE_ORIGIN=https://YOUR-UNIFIED-SERVICE.onrender.com
AI_SERVICE_ORIGIN=https://YOUR-UNIFIED-SERVICE.onrender.com
AI_IDENTITY_HMAC_SECRET=REUSE_THE_EXISTING_SECRET_AT_LEAST_32_RANDOM_BYTES_SHARED_WITH_UNIFIED_BACKEND
PUBLIC_FRONTEND_ORIGIN=https://sketchizi.pages.dev
