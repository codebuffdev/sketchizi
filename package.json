    "preview": "vite preview",
    "sync:eraser": "node scripts/sync-eraser-icons.mjs",
    "collaboration-server": "node server/collaboration-server.mjs",
    "test:networking": "node --test tests/networking.test.js",
    "test:catalog": "node --test tests/architecture-catalog.test.js",
    "test:chat": "node --test tests/chat-protocol.test.js",
    "test:sync": "node --import ./tests/register-sync-test-loader.mjs --test tests/collaboration-sync-characterization.test.js tests/collaboration-sync-core.test.js tests/sync-diagnostics.test.js",
    "test:sync-performance": "node --import ./tests/register-sync-test-loader.mjs ./tests/sync-performance-sample.mjs",
    "test:ui-defaults": "node --test tests/ui-defaults.test.js",
    "test:auth-gateway": "node --test tests/auth-gateway.test.js",
